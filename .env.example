# Copy this file to .env and fill in your values

# Required — Anthropic API key for scoring and outreach personalisation
ANTHROPIC_API_KEY=sk-ant-...

# Outreach sender details (used in message signatures)
SENDER_NAME=Your Name
SENDER_EMAIL=you@example.com

# Optional — free ABR API key for ABN/ASIC enrichment
# Register at: https://abr.business.gov.au/Documentation/AbrWebServiceDescription
ABN_LOOKUP_API_KEY=
